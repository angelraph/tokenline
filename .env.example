# Public site
PUBLIC_BASE_URL=http://localhost:3000

# Storage: set DATABASE_URL for Postgres (Neon/Supabase). Empty = local JSON file in ./data
DATABASE_URL=

# UsePod (upstream inference). The token lives in the path: https://api.usepod.ai/proxy/<token>/v1
USEPOD_PROXY_TOKEN=
USEPOD_BASE_URL=https://api.usepod.ai/proxy
MEMO_MODEL=deepseek-v4-1-flash

# Helius (free for registered Clawrena teams)
HELIUS_API_KEY=

# Treasury addresses (public keys only; never put private keys here)
POOL_WALLET=            # receives repayments (SOL / USDC) and LP deposits
ESCROW_WALLET=          # receives $ANSEM / $TLINE collateral (may equal POOL_WALLET)

# Mints
ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
TLINE_MINT=             # fill after launching $TLINE on ClawPump
USDC_MINT=EPjFWJ5vKuqjqCWQyeAJsbRUPkCmtD2CHAANnUQwDRx4

# Credit policy
SPREAD_BPS=1500         # 15% on top of upstream cost
BASE_LINE_CAP_USD=0.5   # max unsecured line per agent; raise as the pool grows
COLLATERAL_LTV=0.5      # $ANSEM counts at 50% of market value
TLINE_HOLDER_BOOST=0.25 # +25% line for holders of >= TLINE_HOLDER_MIN
TLINE_HOLDER_MIN=100000

# Brand
X_HANDLE=tokenlinehq

# Credit reports sold to other agents over x402 (paid to POOL_WALLET)
REPORT_PRICE_USD=0.02
QUOTE_SECRET=           # any long random string

# Admin (verify X handles, freeze lines, run sync)
ADMIN_TOKEN=
CRON_SECRET=

# x402 mode (no prepaid UsePod balance needed): leave USEPOD_PROXY_TOKEN empty and set the
# secret key of a SEPARATE small hot wallet that pays UsePod per request in SOL.
# Never use the pool wallet here. Keep only a few cents in this wallet.
# On Vercel, add it as a Sensitive environment variable. Never commit it.
SPENDER_SECRET_KEY=
